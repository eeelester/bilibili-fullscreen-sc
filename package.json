{
  "name": "bilibili-fullscreen-sc",
  "version": "0.10.0",
  "packageManager": "pnpm@9.15.9",
  "description": "B站助手，全屏显示SC，评论显示IP属地",
  "author": "elester",
  "license": "MIT",
  "keywords": [
    "bilibili",
    "sc",
    "fullscreen",
    "B站",
    "直播",
    "全屏SC"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "wxt:submit-init": "wxt submit init",
    "wxt:submit": "wxt submit --chrome-zip .output/*-chrome.zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:e2e": "jest --config jest.browser.config.js --runInBand",
    "prepare": "husky install",
    "release": "release-it"
  },
  "dependencies": {
    "bilibili-live-ws": "^6.3.1",
    "md5": "^2.3.0",
    "rc-switch": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.4.3",
    "@eslint/eslintrc": "^2.1.4",
    "@jest/globals": "^29.7.0",
    "@release-it/conventional-changelog": "^8.0.1",
    "@testing-library/jest-dom": "5.16.4",
    "@types/eslint__eslintrc": "^2.1.1",
    "@types/jest": "^29.5.11",
    "@types/md5": "^2.3.5",
    "@types/node": "^24.0.0",
    "@types/rc-switch": "^1.9.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "puppeteer": "^21.6.0",
    "release-it": "^17.2.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "web-ext": "^9.2.0",
    "wxt": "^0.21.5"
  },
  "pnpm": {
    "overrides": {
      "@wxt-dev/module-react>@vitejs/plugin-react": "^4.7.0"
    }
  },
  "lint-staged": {
    "{components,entrypoints,utils,constant}/**/*.{js,jsx,tsx,ts}": [
      "eslint --fix"
    ]
  },
  "volta": {
    "node": "24.22.2",
    "pnpm": "9.15.9"
  }
}
