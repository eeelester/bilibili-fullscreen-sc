{
  "compilerOptions": {
    "target": "es2016",
    "baseUrl": "./",
    "module": "commonjs",
    "paths": {
      "@/*": ["../src/*"]
    },
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
